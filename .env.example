# 서버(Railway 서비스)에서만 쓰는 환경변수. 실제 값은 커밋하지 마세요.
# 로컬: 이 파일을 .env 로 복사한 뒤 값을 채우고, 셸에 export 하거나 dx serve 앞에 지정합니다.

# PostgreSQL 접속 URL
#  - 로컬 Docker 예시: postgres://shorturl:<비밀번호>@localhost:5432/shorturl
#  - Railway: 서비스 Variables 에서 DATABASE_URL=${{Postgres.DATABASE_URL}} 로 참조
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# (선택) 커넥션 풀 최대 크기. 기본값 5
DATABASE_MAX_CONNECTIONS=5

# 바인딩 주소. Railway 는 PORT 를 자동 주입하므로 보통 IP 만 지정하면 됩니다.
IP=0.0.0.0
PORT=8080
